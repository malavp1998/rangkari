# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NEVER expose to browser

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Found in: Razorpay Dashboard → Settings → API Keys
# Use test keys (rzp_test_*) during development, live keys (rzp_live_*) in production
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key-id   # Safe for browser (key ID only, not secret)

# ─── Resend (email) ──────────────────────────────────────────────────────────
# Found in: Resend Dashboard → API Keys
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=orders@yourdomain.com   # Must be a verified domain in Resend

# ─── Admin ───────────────────────────────────────────────────────────────────
# Your admin email — used to restrict access to /admin routes
ADMIN_EMAIL=your-admin-email@example.com

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Change to your domain in production
